# AI / LLM Configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional alternative to OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (supports sqlite, mysql, mongodb)
# SQLite:  sqlite:///./evaluator.db
# MySQL:   mysql+pymysql://user:password@localhost:3306/evaluator_db
# MongoDB: mongodb://localhost:27017/evaluator_db
DATABASE_URL=sqlite:///./evaluator.db
MONGODB_URI=
MONGODB_DB=evaluator_db

# Fine-tuned DistilBERT Hallucination Model Path
HALLUCINATION_MODEL_PATH=./hallucination_model/hallucination_model

# Chroma Vector Store & Uploads
CHROMA_DIR=./data/chroma
MAX_TEXT_CHARS=18000

